APP_NAME="Prex GIFs API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MariaDB service of docker-compose.yml)
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=prex_gifs
DB_USERNAME=prex
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

# ---------------------------------------------------------------------------
# GIPHY (https://developers.giphy.com/docs/api/#quick-start-guide)
# ---------------------------------------------------------------------------
GIPHY_API_KEY=
GIPHY_BASE_URL=https://api.giphy.com/v1
GIPHY_TIMEOUT=10
GIPHY_CONNECT_TIMEOUT=5
GIPHY_RETRIES=2
GIPHY_RETRY_DELAY_MS=200
GIPHY_RATING=g
GIPHY_LANGUAGE=en

# ---------------------------------------------------------------------------
# OAuth2 / Passport
# ---------------------------------------------------------------------------
OAUTH_ACCESS_TOKEN_TTL_MINUTES=30
OAUTH_REFRESH_TOKEN_TTL_MINUTES=1440
OAUTH_TOKEN_NAME=api
OAUTH_ENABLE_PASSWORD_GRANT=true

# ---------------------------------------------------------------------------
# Audit trail
# ---------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_MAX_PAYLOAD_BYTES=65535

# ---------------------------------------------------------------------------
# Demo credentials created by `php artisan db:seed`
# ---------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@prex.local
DEMO_USER_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
