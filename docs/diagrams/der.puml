@startuml der
' ---------------------------------------------------------------------------
' Challenge PHP Hexagonal - Data model (DER)
' ---------------------------------------------------------------------------
hide circle
skinparam shadowing false
skinparam linetype ortho

entity "users" as users {
  * id : BIGINT UNSIGNED <<PK>>
  --
  * name : VARCHAR(255)
  * email : VARCHAR(255) <<unique>>
  * password : VARCHAR(255)
  email_verified_at : TIMESTAMP
  remember_token : VARCHAR(100)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "favorite_gifs" as favorites {
  * id : UUID <<PK>>
  --
  * user_id : BIGINT UNSIGNED <<FK users.id>>
  * gif_id : VARCHAR(64)
  * alias : VARCHAR(100)
  * saved_at : TIMESTAMP
  --
  unique (user_id, gif_id)
  index (user_id, saved_at)
}

entity "service_interactions" as interactions {
  * id : UUID <<PK>>
  --
  user_id : BIGINT UNSIGNED <<FK users.id>> <<nullable>>
  * http_method : VARCHAR(10)
  * path : VARCHAR(255)
  service_name : VARCHAR(255)
  * request_body : JSON
  * response_status : SMALLINT UNSIGNED
  * response_body : JSON
  * ip_address : VARCHAR(45)
  * occurred_at : TIMESTAMP
  --
  index (user_id, occurred_at)
  index (service_name), index (response_status)
  index (occurred_at)
}

entity "oauth_clients" as clients {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(255)
  secret : VARCHAR(255) <<nullable>>
  provider : VARCHAR(255) <<nullable>>
  * redirect_uris : TEXT
  * grant_types : TEXT
  * revoked : BOOLEAN
}

entity "oauth_access_tokens" as tokens {
  * id : CHAR(80) <<PK>>
  --
  user_id : BIGINT UNSIGNED <<ref users.id>> <<nullable>>
  * client_id : UUID <<ref oauth_clients.id>>
  name : VARCHAR(255)
  scopes : TEXT
  * revoked : BOOLEAN
  expires_at : DATETIME
}

entity "oauth_refresh_tokens" as refresh {
  * id : CHAR(80) <<PK>>
  --
  * access_token_id : CHAR(80) <<ref oauth_access_tokens.id>>
  * revoked : BOOLEAN
  expires_at : DATETIME
}

users ||--o{ favorites : "saves"
users ||--o{ interactions : "performs"
users ||--o{ tokens : "owns"
clients ||--o{ tokens : "issues"
tokens ||--o| refresh : "can be renewed by"

note as ForeignKeys
  <b>FK</b> marks a foreign key enforced by the database;
  <b>ref</b> marks a relation that only exists in the
  application. The schema declares exactly two
  constraints - favorite_gifs.user_id (ON DELETE
  CASCADE) and service_interactions.user_id
  (ON DELETE SET NULL); Passport's tables are
  joined through indexes only, and client_id has
  not even that. Passport's tables are drawn with
  the columns that matter here, not all of them.
end note

note bottom of favorites
  gif_id is the GIPHY identifier: the catalog
  is external, so no local "gifs" table exists.
end note
@enduml
